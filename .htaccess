DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive framework folders
    RewriteRule ^(?:\.env|\.git|app/|config/|database/|resources/|storage/) - [F,L,NC]

    # Block sensitive file extensions
    <FilesMatch "\.(sql|log|md|env|ini|yml|yaml|bak|sh|lock)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order Allow,Deny
            Deny from all
        </IfModule>
    </FilesMatch>

    Options -Indexes

    # Rewrite all requests to index.php if not an existing file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
